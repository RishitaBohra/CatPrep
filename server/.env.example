# Copy this file to .env and fill in your real values. Never commit .env itself.

# Your MongoDB Atlas connection string (from Atlas -> Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@cat-tracker.xxxxx.mongodb.net/cat_tracker?retryWrites=true&w=majority

# Any long random string - used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Port the server listens on (Render sets this automatically in production)
PORT=5000

# Comma-separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173,https://catprep-tracker.netlify.app
